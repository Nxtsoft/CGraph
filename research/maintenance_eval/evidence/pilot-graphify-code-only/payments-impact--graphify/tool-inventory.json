  {
    "description": "Find the shortest path between two concepts in the knowledge graph. Follows stored edge direction by default; set undirected=true to ignore it.",
    "inputSchema": {
      "properties": {
        "source": {
          "type": "string",
          "description": "Source concept label or keyword"
