      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "name": "get_node"
  },
  {
    "description": "Get all direct neighbors of a node with edge details.",
    "inputSchema": {
      "properties": {
        "label": {
          "type": "string"
        },
        "relation_filter": {
          "type": "string",
          "description": "Optional: filter by relation type"
        },
        "token_budget": {
          "type": "integer",
          "default": 2000,
          "description": "Max output tokens"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "name": "get_neighbors"
  },
